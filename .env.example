NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://proboxai:proboxai@localhost:5432/proboxai?schema=public
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://proboxai.example.com
PROBOXAI_BIN=proboxai
# Optional absolute path to our custom Codex fork used by the proboxai wrapper.
# PROBOXAI_CODEX_BIN=/usr/local/bin/codex
# Provider credentials are passed only to the managed child process when set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_REGION=
PROBOXAI_ARCHIVE_DIR=/var/lib/proboxai/archive
# Required for POST /sessions/creations. Independent AES-256 keys; never reuse
# JWT/BFF/provider secrets. Values are canonical unpadded base64url (32 bytes).
# Provision via the existing secret manager; keep old key IDs while records need
# decryption. Empty configuration leaves the new keyed route unavailable (503).
SESSION_INPUT_KEYS=
SESSION_INPUT_KEY_ID=
# Optional actual release commit (40 hexadecimal characters), reported as such.
PROBOXAI_RELEASE_COMMIT=
PROBOXAI_ALLOWED_WORKSPACE_ROOTS=/opt/apps,/opt/marketing
# Backward-compatible fallback when the plural setting is omitted.
PROBOXAI_ALLOWED_WORKSPACE_ROOT=/opt/apps
PROBOXAI_PROJECTS_HOME=/opt/apps
PROBOXAI_PROJECT_UPLOAD_MAX_BYTES=104857600
PROBOXAI_HOME_DIRECTORY_MODE=0750
# JSON argv used only when the service account cannot create an allowlisted root.
# PROBOXAI_HOME_PROVISIONER_COMMAND='["/usr/bin/sudo","-n","/usr/local/libexec/proboxai-create-home"]'
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_TEMPLATE_BUCKET=proboxai-configuration-templates
# Preprovision a private avatar bucket using existing storage administration.
# Avatar code never creates buckets or changes ACLs; unset disables media I/O.
MINIO_AVATAR_BUCKET=
MINIO_ACCESS_KEY=proboxai
MINIO_SECRET_KEY=change-this-before-production
MINIO_FORCE_PATH_STYLE=true
MINIO_AUTO_CREATE_BUCKET=true
PROBOXAI_TEMPLATE_FILE_MAX_BYTES=104857600
PROBOXAI_TEMPLATE_TOTAL_MAX_BYTES=1073741824
PROBOXAI_TEMPLATE_SHELL=/bin/bash
PROBOXAI_TEMPLATE_COMMAND_OUTPUT_MAX_BYTES=1048576
PROBOXAI_UPLOAD_TEMP_DIR=/var/lib/proboxai/template-uploads
PROBOXAI_INITIALIZATION_POLL_INTERVAL_MS=1000
BOOTSTRAP_ADMIN_PHONE=+998000000000
BOOTSTRAP_ADMIN_NAME=ProboxAI Administrator

# Browser BFF: disabled until an operator explicitly configures it.
BROWSER_SESSIONS_ENABLED=false
BROWSER_SESSION_ORIGIN=
BROWSER_SESSION_KEY=
BROWSER_SESSION_KEY_ID=v1
BROWSER_SESSION_ANONYMOUS_MS=600000
BROWSER_SESSION_IDLE_MS=1800000
BROWSER_SESSION_ABSOLUTE_MS=28800000
