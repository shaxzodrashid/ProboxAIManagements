  description     String
  criteria        String?
  status          TaskStatus             @default(QUEUED)
  creatorId       String
  creator         User                   @relation("taskCreator", fields: [creatorId], references: [id])
  managerId       String
  manager         User                   @relation("taskManager", fields: [managerId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        ProboxAiSession[]

  @@index([workspaceId, status])
  @@index([managerId, status])
}

model TaskCreationReceipt {
  workspaceId String
  creatorId   String
  requestId   String
  taskId      String    @unique
  inputHash   String    @db.VarChar(64)
  outcome     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [creatorId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([workspaceId, creatorId, requestId])
}

model TaskHumanState {
  archivedAt        DateTime?
  deletedAt         DateTime?
  completed         Boolean?
  completedById     String?
  completedAt       DateTime?
  priority          TaskPriority?
  taskId            String                 @id
  task              Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  revision          Int                    @default(0)
  updatedAt         DateTime               @default(now()) @updatedAt
  audits            TaskHumanAudit[]
  sharingOperations TaskSharingOperation[]
}

model TaskAssignee {
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId, taskId])
}

model TaskChecklistItem {
  // Null retains the original side for legacy writers/items. No project identity is public.
  sectionBoardId String?
  parentId       String?
  parent         TaskChecklistItem?  @relation("checklistTree", fields: [parentId], references: [id], onDelete: NoAction)
  children       TaskChecklistItem[] @relation("checklistTree")
  id             String              @id @default(uuid())
  taskId         String
  task           Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
