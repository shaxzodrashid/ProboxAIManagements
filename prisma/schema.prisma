  assignee       User                @relation("humanChecklistAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  title          String
  position       Int
  completed      Boolean             @default(false)
  completedById  String?
  completedAt    DateTime?
  deadline       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([taskId, position])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  revision  Int
  createdAt DateTime @default(now())

  @@unique([taskId, revision])
}

model TaskHumanAudit {
  id        String         @id @default(uuid())
  taskId    String
