  expiresAt       DateTime
  revokedAt       DateTime?
  consumedAt      DateTime?
  createdAt       DateTime            @default(now())

  @@index([userId, purpose, expiresAt])
}

// Opaque browser IDs are hashed. Token/CSRF bundles use independent AEAD encryption.
model BrowserSession {
  id                String        @id
  userId            String?
  workspaceId       String?
  refreshId         String?
  refresh           SessionToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  bundle            String
  csrfHash          String
  createdAt         DateTime      @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?

  @@index([absoluteExpiresAt])
  @@index([refreshId])
}

model Task {
  creationReceipt TaskCreationReceipt?
  humanState      TaskHumanState?
  assignees       TaskAssignee[]
  checklist       TaskChecklistItem[]
  comments        TaskComment[]
  deadline        TaskDeadline?
