generator client {
  provider = "prisma-client-js"
}

enum ArticleReviewState {
  WAITING_VOTERS
  PENDING
  APPROVED
  REJECTED
}

// Reserved identities and private staging do not create published content.
model ArticleDocument {
  resolutionReviews ArticleResolutionReview[]
  id                String                        @id
  projectId         String
  creatorId         String
  headVersionId     String?
  createdAt         DateTime                      @default(now())
  versions          ArticlePublishedVersion[]     @relation("documentVersions")
  head              ArticlePublishedVersion?      @relation("documentHead", fields: [id, headVersionId], references: [documentId, id], onDelete: NoAction, onUpdate: NoAction)
  contributions     ArticleProposalContribution[]
  candidates        ArticleProposalCandidate[]

  @@unique([id, headVersionId])
  @@unique([projectId, id])
  @@index([projectId, id])
}

model ArticlePublishedVersion {
  id                 String                   @id
  documentId         String
  number             Int
  reviewId           String?                  @unique
  resolutionReviewId String?                  @unique
  comparison         Json
  provenance         Json
  createdAt          DateTime                 @default(now())
  document           ArticleDocument          @relation("documentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  headFor            ArticleDocument?         @relation("documentHead")
  review             ArticleReview?           @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  resolutionReview   ArticleResolutionReview? @relation(fields: [documentId, resolutionReviewId], references: [documentId, id], onDelete: Restrict)

  @@unique([documentId, id])
  @@unique([documentId, resolutionReviewId])
  @@unique([documentId, number])
}

model ArticlePublicationSpace {
  projectId    String @id
  revision     Int    @default(0)
  nextSequence Int    @default(0)
  forest       Json
}

// Immutable explicit source/provenance, independent of a future merged candidate.
model ArticleProposalContribution {
  id                 String                    @id
  documentId         String
  authorId           String
  sourceArticleId    String
  sourceRevision     Int
  baseVersionId      String?
  baseForestRevision Int
  inputHash          String                    @db.VarChar(64)
  comparison         Json
  createdAt          DateTime                  @default(now())
  document           ArticleDocument           @relation(fields: [documentId], references: [id], onDelete: Restrict)
  candidate          ArticleProposalCandidate?

  @@unique([documentId, authorId, inputHash])
}

// FIFO reservations only. This slice exposes no merge, dispatch, vote or promotion mutation.
model ArticleProposalCandidate {
  submittedAt        DateTime?
  submittedSequence  Int?
  resolutionReviewId String?
  resolutionReview   ArticleResolutionReview?    @relation(fields: [resolutionReviewId], references: [id], onDelete: Restrict)
  id                 String                      @id
  projectId          String
  documentId         String
  authorId           String
  sequence           Int
  revision           Int                         @default(0)
  contributionId     String                      @unique
  reachedReviewersAt DateTime?
  document           ArticleDocument             @relation(fields: [projectId, documentId], references: [projectId, id], onDelete: Restrict)
  contribution       ArticleProposalContribution @relation(fields: [contributionId], references: [id], onDelete: Restrict)

  @@unique([projectId, sequence])
  @@unique([projectId, submittedSequence])
  @@index([documentId, sequence])
}

model ArticleResolutionReview {
  baseVersionId      String?
  baseForestRevision Int?
  publishedVersion   ArticlePublishedVersion?
  headSequence       Int
  id                 String                      @id
  projectId          String
  documentId         String
  selectedById       String
  phase              String                      @default("RESOLVING")
  before             Json
  materialization    Json
  createdAt          DateTime                    @default(now())
  document           ArticleDocument             @relation(fields: [projectId, documentId], references: [projectId, id], onDelete: Restrict)
  candidates         ArticleProposalCandidate[]
  reviewers          ArticleResolutionReviewer[]

  @@unique([projectId, headSequence])
  @@unique([documentId, id])
  @@index([projectId, documentId])
}

model ArticleResolutionReviewer {
  reviewId      String
  userId        String
  choiceVersion Int                        @default(0)
  review        ArticleResolutionReview    @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  choices       ArticleResolutionChoice[]
  ballots       ArticleResolutionBallot[]
  approval      ArticleResolutionApproval?

  @@id([reviewId, userId])
}

model ArticleResolutionApproval {
  reviewId  String
  userId    String
  approved  Boolean
  createdAt DateTime                  @default(now())
  reviewer  ArticleResolutionReviewer @relation(fields: [reviewId, userId], references: [reviewId, userId], onDelete: Restrict)

  @@id([reviewId, userId])
}

model ArticleResolutionBallot {
  reviewId  String
  userId    String
  option    String
  round     Int                       @default(1)
  createdAt DateTime                  @default(now())
  reviewer  ArticleResolutionReviewer @relation(fields: [reviewId, userId], references: [reviewId, userId], onDelete: Restrict)

  @@id([reviewId, userId, round])
}

model ArticleResolutionChoice {
  reviewId  String
  userId    String
  version   Int
  choices   Json
  createdAt DateTime                  @default(now())
  reviewer  ArticleResolutionReviewer @relation(fields: [reviewId, userId], references: [reviewId, userId], onDelete: Restrict)

  @@id([reviewId, userId, version])
}

// Stable original keys and immutable submitted content survive live deletion.
model ArticleReview {
  publishedVersions ArticlePublishedVersion[]
  id                String                    @id
  projectId         String
  projectRefId      String?
  authorId          String
  articleId         String
  sourceRevision    Int
  snapshot          Json
  state             ArticleReviewState        @default(WAITING_VOTERS)
  revision          Int                       @default(0)
  selectedById      String?
  createdAt         DateTime                  @default(now())
  decidedAt         DateTime?
  project           Project?                  @relation(fields: [projectRefId], references: [id], onDelete: SetNull)
  voters            ArticleReviewVoter[]

  @@unique([projectId, authorId, articleId, sourceRevision])
  @@index([projectId, id])
}

model ArticleReviewVoter {
  reviewId String
  userId   String
  approved Boolean?
  votedAt  DateTime?
  review   ArticleReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@id([reviewId, userId])
}

// One individual private workspace per project; never stored in project files.
model ArticleDraftSpace {
  projectId    String
  ownerId      String
  projectRefId String?
  ownerRefId   String?
  revision     Int                    @default(0)
  forest       Json
  project      Project?               @relation(fields: [projectRefId], references: [id], onDelete: SetNull)
  owner        User?                  @relation(fields: [ownerRefId], references: [id], onDelete: SetNull)
  versions     ArticleDraftRevision[]

  @@id([projectId, ownerId])
}

// Retained for preservation only; no history disclosure or restore API.
model ArticleDraftRevision {
  projectId String
  ownerId   String
  revision  Int
  forest    Json
  createdAt DateTime          @default(now())
  space     ArticleDraftSpace @relation(fields: [projectId, ownerId], references: [projectId, ownerId], onDelete: Restrict)

  @@id([projectId, ownerId, revision])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  OPEN
  BANNED
  DELETED
}

enum ProfileAudienceField {
  AVATAR
  BIO
  STATUS
  BIRTHDAY_DAY_MONTH
  BIRTHDAY_YEAR
}

enum ProfileAudienceMode {
  NO_ONE
  EVERYONE
  CONTACTS
  CUSTOM
}

enum AuthOtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum SessionTokenPurpose {
  REGISTRATION
  PASSWORD_RESET
  REFRESH
}

enum TaskStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum SessionStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  INTERRUPTED
  ARCHIVED
}

enum TurnStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  INITIALIZING
  READY
  FAILED
  DELETING
}

enum ProjectFileTrashStatus {
  PREPARED
  NEEDS_REPAIR
  FAILED
  ACTIVE
  RESTORED
  PURGED
  PURGE_FAILED
}

enum ProjectFileDeletionConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ProjectDeletionRequestStatus {
  PENDING_OWNER_APPROVAL
  AWAITING_ACTIVE_SESSIONS
  AWAITING_TOKEN
  DELETING
  COMPLETED
  CANCELLED
  FAILED
}

enum ConfigurationTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum ConfigurationTemplateVersionStatus {
  DRAFT
  PUBLISHED
}

enum TemplateCommandStageMode {
  SEQUENTIAL
  PARALLEL
}

enum TemplateCommandType {
  STRUCTURED
  SHELL
}

enum ProjectInitializationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProjectInitializationStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TemplateObjectCleanupStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Workspace {
  taskCreations              TaskCreationReceipt[]
  projectCreationSubmissions ProjectCreationSubmission[]
  authorizationRevision      Int                                 @default(0)
  id                         String                              @id @default(uuid())
  slug                       String                              @unique @default("default")
  // Kept during the v1 compatibility window. Department.homePath is the
  // authoritative setting for new code.
  projectsHomePath           String?
  createdAt                  DateTime                            @default(now())
  users                      User[]
  tasks                      Task[]
  departments                Department[]
  projects                   Project[]
  configurationTemplates     ConfigurationTemplate[]
  sessions                   ProboxAiSession[]
  roles                      Role[]
  profileAudienceRecipients  ProfileAudienceWorkspaceRecipient[]
}

model ProjectCreationSubmission {
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestId           String
  actorId             String
  inputHash           String
  departmentId        String
  templateVersionId   String?
  targetPath          String
  executorId          String
  state               String    @default("UNRESOLVED")
  projectId           String?
  initializationId    String?
  failureCode         String?
  executionFinishedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@id([workspaceId, requestId])
  @@index([state, executionFinishedAt])
}

// Telegram UI state is durable; identifiers are re-authorized on every use.
model TelegramConversation {
  userId          String   @id
  projectId       String?
  sessionId       String?
  providerId      String   @default("openai")
  model           String?
  reasoningEffort String?
  updatedAt       DateTime @updatedAt
}

model TelegramUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

model TelegramSession {
  sessionId     String          @id
  session       ProboxAiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  chatId        BigInt
  projectId     String
  lastSequence  Int             @default(0)
  toolMessageId Int?
  toolState     Json            @default("{}")
  finished      Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([finished, createdAt])
  @@index([userId, projectId])
}

model User {
  articleDraftSpaces        ArticleDraftSpace[]
  customStatusText          String?                           @db.VarChar(300)
  customStatusEmoji         String?                           @db.VarChar(32)
  customStatusExpiresAt     DateTime?                         @db.Timestamptz(3)
  avatarAssetId             String?                           @unique
  avatarAsset               ProfileAvatarAsset?               @relation("activeProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  avatarUploads             ProfileAvatarAsset[]              @relation("profileAvatarOwner")
  profileRevision           Int                               @default(0)
  profileSaves              ProfileSaveReceipt[]
  manualProfileStatus       ManualProfileStatus?
  taskCreations             TaskCreationReceipt[]
  chatGroupsCreated         ChatGroup[]                       @relation("chatGroupCreator")
  chatGroupsOwned           ChatGroup[]                       @relation("chatGroupOwner")
  chatGroupMessages         ChatGroupMessage[]
  chatGroupReactions        ChatGroupMessageReaction[]
  chatGroupCreations        ChatGroupCreation[]
  humanTaskAssignments      TaskAssignee[]
  humanChecklistAssignments TaskChecklistItem[]               @relation("humanChecklistAssignee")
  id                        String                            @id @default(uuid())
  workspaceId               String
  workspace                 Workspace                         @relation(fields: [workspaceId], references: [id])
  phoneNumber               String                            @unique
  fullName                  String
  firstName                 String?                           @db.VarChar(120)
  lastName                  String?                           @db.VarChar(120)
  bio                       String?                           @db.VarChar(1000)
  birthDate                 DateTime?                         @db.Date
  audiencePolicies          ProfileAudiencePolicy[]
  audienceAccountGrants     ProfileAudienceAccountRecipient[]
  contactsOwned             ProfileContact[]                  @relation("contactOwner")
  contactGrants             ProfileContact[]                  @relation("contactTarget")
  username                  String?                           @unique
  passwordHash              String?
  status                    UserStatus                        @default(PENDING)
  telegramUserId            BigInt?                           @unique
  telegramChatId            BigInt?                           @unique
  verifiedAt                DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  tasksCreated              Task[]                            @relation("taskCreator")
  tasksAssigned             Task[]                            @relation("taskManager")
  projectsCreated           Project[]                         @relation("projectCreator")
  projectMemberships        ProjectMember[]
  templatesCreated          ConfigurationTemplate[]           @relation("templateCreator")
  templateVersionsCreated   ConfigurationTemplateVersion[]    @relation("templateVersionCreator")
  templateVersionsPublished ConfigurationTemplateVersion[]    @relation("templateVersionPublisher")
  sessionsCreated           ProboxAiSession[]                 @relation("sessionCreator")
  approvals                 ApprovalRequest[]                 @relation("approvalDecider")
  otps                      AuthOtp[]
  tokens                    SessionToken[]
  notifications             NotificationDelivery[]
  protectedFileTypesCreated ProjectProtectedFileType[]        @relation("protectedFileTypeCreator")
  fileTrashCreated          ProjectFileTrashItem[]            @relation("fileTrashCreator")
  fileDeletionRequests      ProjectFileDeletionConfirmation[] @relation("fileDeletionRequester")
  projectDeletionRequests   ProjectDeletionRequest[]          @relation("projectDeletionRequester")
  projectDeletionAudits     ProjectDeletionAudit[]            @relation("projectDeletionOwner")
  roleAssignments           UserRoleAssignment[]              @relation("userRoleAssignments")
  roleAssignmentsMade       UserRoleAssignment[]              @relation("roleAssignmentCreator")
  chatGroupMemberships      ChatGroupMembership[]
  groupInvitationsSent      ChatGroupInvitation[]             @relation("groupInvitationSender")
  groupInvitationsReceived  ChatGroupInvitation[]             @relation("groupInvitationRecipient")
  directConversationsLower  HumanDirectConversation[]         @relation("directConversationLower")
  directConversationsUpper  HumanDirectConversation[]         @relation("directConversationUpper")

  @@unique([id, workspaceId])
}

enum ProfileAvatarState {
  UPLOADING
  STAGED
  ACTIVE
  DELETE_PENDING
  DELETING
  DELETED
}

model ProfileAvatarAsset {
  id            String             @id @default(uuid())
  ownerId       String
  owner         User               @relation("profileAvatarOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activeFor     User?              @relation("activeProfileAvatar")
  requestId     String
  inputHash     String
  objectKey     String             @unique
  sha256        String
  size          Int
  width         Int
  height        Int
  state         ProfileAvatarState @default(UPLOADING)
  expiresAt     DateTime
  uploadedAt    DateTime?
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastErrorCode String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([ownerId, requestId])
  @@index([state, nextAttemptAt, expiresAt])
}

// Private acknowledgments only: never a snapshot of historical profile content.
model ProfileSaveReceipt {
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId        String
  workspaceId      String
  actorId          String
  inputHash        String
  expectedRevision Int
  revision         Int
  statusRequestId  String?  @unique
  createdAt        DateTime @default(now())

  @@id([ownerId, requestId])
}

enum ManualAvailability {
  AVAILABLE
  AWAY
  BUSY
}

model ManualProfileStatus {
  ownerId      String                        @id
  owner        User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  availability ManualAvailability?
  revision     Int                           @default(0)
  mutations    ManualProfileStatusMutation[]
}

model ManualProfileStatusMutation {
  ownerId          String
  requestId        String
  status           ManualProfileStatus @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  workspaceId      String
  actorId          String
  expectedRevision Int
  revision         Int
  before           ManualAvailability?
  availability     ManualAvailability?
  createdAt        DateTime            @default(now())

  @@id([ownerId, requestId])
  @@unique([ownerId, revision])
}

model ChatGroup {
  id                    String                          @id @default(uuid())
  name                  String                          @db.VarChar(120)
  creatorId             String
  ownerId               String
  creator               User                            @relation("chatGroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  owner                 User                            @relation("chatGroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt             DateTime                        @default(now())
  creation              ChatGroupCreation?
  permissionRevision    Int                             @default(0)
  membersCanSend        Boolean                         @default(true)
  sendingRevision       Int                             @default(0)
  lastMessageSequence   Int                             @default(0)
  messages              ChatGroupMessage[]
  sendingAudits         ChatGroupSendingAudit[]
  memberships           ChatGroupMembership[]
  invitationPermissions ChatGroupInvitationPermission[]
  permissionAudits      ChatGroupPermissionAudit[]
  invitations           ChatGroupInvitation[]

  @@index([creatorId, createdAt])
}

model ChatGroupCreation {
  creatorId      String
  requestId      String
  inputHash      String    @db.VarChar(64)
  groupId        String    @unique
  initialName    String    @db.VarChar(120)
  initialOwnerId String
  createdAt      DateTime  @default(now())
  creator        User      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  group          ChatGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([creatorId, requestId])
}

model ChatGroupMessage {
  reactions ChatGroupMessageReaction[]
  // Null is the existing unthreaded partition. No topic-management API is implied.
  topicId   String?                    @db.Uuid
  id        String                     @id @default(uuid())
  groupId   String
  authorId  String
  requestId String
  text      String                     @db.VarChar(4000)
  sequence  Int
  createdAt DateTime                   @default(now())
  group     ChatGroup                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User                       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([groupId, authorId, requestId])
  @@unique([groupId, sequence])
  @@index([groupId, topicId, sequence])
}

model ChatGroupMessageReaction {
  messageId String
  accountId String
  emoji     String           @db.VarChar(64)
  createdAt DateTime         @default(now())
  message   ChatGroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  account   User             @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([messageId, accountId, emoji])
  @@index([messageId, emoji])
}

model ChatGroupSendingAudit {
  id             String    @id @default(uuid())
  groupId        String
  actorId        String
  membersCanSend Boolean
  revision       Int
  createdAt      DateTime  @default(now())
  group          ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, revision])
}

enum GroupHistoryAccess {
  NONE
  LAST_100
  LAST_300
  ALL
}

enum GroupInviteMode {
  DIRECT
  APPROVABLE
}

enum GroupInvitationStatus {
  PENDING
  ADDED
  ACCEPTED
  DECLINED
}

model ChatGroupMembership {
  historyEpoch          String?
  historyCutoffSequence Int?
  historyBoundaries     ChatGroupHistoryBoundary[]
  groupId               String
  accountId             String
  historyAccess         GroupHistoryAccess         @default(NONE)
  joinedAt              DateTime                   @default(now())
  invitationId          String?                    @unique
  group                 ChatGroup                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account               User                       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([groupId, accountId])
  @@index([accountId, groupId])
}

model ChatGroupHistoryBoundary {
  groupId       String
  accountId     String
  // MAIN denotes null topicId; other keys are canonical topic UUIDs.
  topicKey      String
  firstSequence Int
  membership    ChatGroupMembership @relation(fields: [groupId, accountId], references: [groupId, accountId], onDelete: Cascade)

  @@id([groupId, accountId, topicKey])
}

model ChatGroupInvitationPermission {
  groupId     String
  accountId   String
  canInvite   Boolean
  grantedById String
  updatedAt   DateTime  @updatedAt
  group       ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, accountId])
}

model ChatGroupPermissionAudit {
  id        String    @id @default(uuid())
  groupId   String
  actorId   String
  accountId String
  canInvite Boolean
  revision  Int
  createdAt DateTime  @default(now())
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, revision])
}

model ChatGroupInvitation {
  id               String                @id @default(uuid())
  groupId          String
  initialGroupName String                @db.VarChar(120)
  inviterId        String
  recipientId      String
  requestId        String
  inputHash        String                @db.VarChar(64)
  mode             GroupInviteMode
  historyAccess    GroupHistoryAccess    @default(NONE)
  status           GroupInvitationStatus
  createdAt        DateTime              @default(now())
  resolvedAt       DateTime?
  group            ChatGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter          User                  @relation("groupInvitationSender", fields: [inviterId], references: [id], onDelete: Restrict)
  recipient        User                  @relation("groupInvitationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  card             DirectInvitationCard?

  @@unique([inviterId, requestId])
  @@index([groupId, recipientId, status])
}

model HumanDirectConversation {
  id             String                 @id @default(uuid())
  lowerAccountId String
  upperAccountId String
  lastSequence   Int                    @default(0)
  createdAt      DateTime               @default(now())
  lowerAccount   User                   @relation("directConversationLower", fields: [lowerAccountId], references: [id], onDelete: Restrict)
  upperAccount   User                   @relation("directConversationUpper", fields: [upperAccountId], references: [id], onDelete: Restrict)
  cards          DirectInvitationCard[]

  @@unique([lowerAccountId, upperAccountId])
}

model DirectInvitationCard {
  id             String                  @id @default(uuid())
  conversationId String
  invitationId   String                  @unique
  sequence       Int
  createdAt      DateTime                @default(now())
  conversation   HumanDirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  invitation     ChatGroupInvitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
}

model Permission {
  key             String           @id
  name            String
  description     String
  category        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([category, name])
}

model Role {
  id              String               @id @default(uuid())
  workspaceId     String
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key             String
  name            String
  description     String?
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@unique([workspaceId, key])
  @@unique([id, workspaceId])
  @@index([workspaceId, name])
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  createdAt     DateTime   @default(now())

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model UserRoleAssignment {
  userId       String
  roleId       String
  workspaceId  String
  assignedById String?
  user         User     @relation("userRoleAssignments", fields: [userId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  role         Role     @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  assignedBy   User?    @relation("roleAssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@index([workspaceId, roleId])
  @@index([assignedById])
}

model Department {
  revision    Int                     @default(0)
  id          String                  @id @default(uuid())
  workspaceId String
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  homePath    String
  isDefault   Boolean                 @default(false)
  status      DepartmentStatus        @default(ACTIVE)
