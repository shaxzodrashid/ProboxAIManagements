  account   User                  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([ownerId, field, accountId])
  @@index([accountId])
}

model ProfileAudienceWorkspaceRecipient {
  ownerId     String
  field       ProfileAudienceField
  workspaceId String
  policy      ProfileAudiencePolicy @relation(fields: [ownerId, field], references: [ownerId, field], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([ownerId, field, workspaceId])
  @@index([workspaceId])
}

model ProfileContact {
  alias            String?  @db.VarChar(120)
  ownerId          String
  contactAccountId String
  owner            User     @relation("contactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact          User     @relation("contactTarget", fields: [contactAccountId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@id([ownerId, contactAccountId])
  @@index([contactAccountId])
}

// A durable command journal precedes any file deletion movement.
model ProjectFileOperation {
  id                  String
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId             String
  originalPath        String
  state               String
  executionTracked    Boolean   @default(false)
  executionStartedAt  DateTime?
  executionFinishedAt DateTime?
  sourceIdentity      String
  contentHash         String
  isDirectory         Boolean
  confirmationId      String?   @unique
  trashId             String?   @unique
  result              Json?
  errorCode           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@id([projectId, id])
  @@index([projectId, createdAt])
}
