  articleDraftSpaces        ArticleDraftSpace[]
  archivedAt                DateTime?
  archiveRevision           Int                               @default(0)
  archiveOperations         ProjectArchiveOperation[]
  lifecycleExecutions       ProjectLifecycleExecution[]
