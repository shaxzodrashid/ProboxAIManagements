  requestId String
  inputHash String
  actorId   String
  action    String
  revision  Int
  before    Json
  after     Json
  comment   Json?
  createdAt DateTime       @default(now())

  @@unique([taskId, requestId])
  @@unique([taskId, revision])
}

model TaskDeadline {
  taskId   String              @id
  task     Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  revision Int                 @default(0)
  value    Json?
  audits   TaskDeadlineAudit[]
}

model TaskDeadlineAudit {
  id        String       @id @default(uuid())
  taskId    String
  deadline  TaskDeadline @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  requestId String
  inputHash String
  actorId   String
  revision  Int
  before    Json
  after     Json
  createdAt DateTime     @default(now())

  @@unique([taskId, requestId])
  @@unique([taskId, revision])
}

model Project {
