model ProjectArchiveOperation {
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestId  String
  actorId    String
  revision   Int
  archivedAt DateTime
  createdAt  DateTime @default(now())

  @@id([projectId, requestId])
  @@unique([projectId, revision])
}

model ProjectLifecycleExecution {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([projectId, finishedAt])
}

// Human workflow is separate from Task.status, which is runner-owned.
model TaskBoard {
  id        String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId String            @unique
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision  Int               @default(0)
  statuses  TaskBoardStatus[]
  audits    TaskBoardAudit[]
}

model TaskBoardStatus {
  id            String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  boardId       String
  board         TaskBoard              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name          String
  color         String
  position      Int
  entries       TaskBoardEntry[]
  sharedEntries TaskSharedBoardEntry[]

  @@unique([boardId, id])
  @@unique([boardId, position])
}

// Only deliberate future task attachment creates an entry; legacy tasks remain unlinked.
model TaskBoardEntry {
  taskId   String          @id
  task     Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  boardId  String
  statusId String
  status   TaskBoardStatus @relation(fields: [boardId, statusId], references: [boardId, id], onDelete: Restrict)

  @@index([boardId, statusId])
}

// Additional explicit associations preserve the existing original board/execution context.
model TaskSharedBoardEntry {
  taskId      String
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  boardId     String
  statusId    String
  status      TaskBoardStatus @relation(fields: [boardId, statusId], references: [boardId, id], onDelete: Restrict)
  createdById String
  createdAt   DateTime        @default(now())

  @@id([taskId, boardId])
  @@index([boardId, statusId])
}

model TaskSharingOperation {
  taskId          String
