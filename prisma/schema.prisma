model ProboxAiSession {
  creationRequestId         String?
  creationInputHash         String?           @db.VarChar(64)
  creationInitialTurnId     String?
  creationAcceptedAt        DateTime?
  runtimeProvenance         Json?
  dispatchAttempts          Int               @default(0)
  lastDispatchAt            DateTime?
  selectedProjectId         String?
  interruptTurnId           String?
  runOwner                  String?
  runLeaseExpiresAt         DateTime?
  recoveryReason            String?
  stopConfirmation          String            @default("NOT_OBSERVED")
  interruptRequestedAt      DateTime?
  interruptSignalAcceptedAt DateTime?
  runnerExitedAt            DateTime?
  id                        String            @id @default(uuid())
  workspaceId               String
  workspace                 Workspace         @relation(fields: [workspaceId], references: [id])
  taskId                    String
  task                      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creatorId                 String
  creator                   User              @relation("sessionCreator", fields: [creatorId], references: [id])
  status                    SessionStatus     @default(QUEUED)
