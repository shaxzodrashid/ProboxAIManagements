  timeoutSeconds      Int                               @default(900)
  initializationSteps ProjectInitializationStep[]

  @@unique([stageId, position])
}

model ProjectInitialization {
  id                String                       @id @default(uuid())
  projectId         String
  project           Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion   ConfigurationTemplateVersion @relation(fields: [templateVersionId], references: [id])
